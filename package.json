{
  "name": "dsh-onebot-channel",
  "version": "0.21.20",
  "description": "把 QQ 私聊与群聊经 OneBot 11 协议接进 DeepSeek Harness：WebSocket 事件推送入站，agent.followup 唤醒会话，提供 qq_send 等工具回发消息、发表情、收藏表情包、查表情目录、发表 QQ 空间说说；消息历史/主动关系卡工具按需恢复。",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "agent",
    "channel",
    "qq",
    "onebot",
    "onebot11",
    "snowluma"
  ],
  "author": "dsh-onebot-channel contributors",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "privacy:scan": "node tools/privacy-scan.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jingyingruodi/dsh-onebot-channel-ops.git"
  },
  "bugs": {
    "url": "https://github.com/jingyingruodi/dsh-onebot-channel-ops/issues"
  },
  "homepage": "https://github.com/jingyingruodi/dsh-onebot-channel-ops#readme"
}
